# Ignore directories generated by Composer.
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/contrib/

# Ignore configuration files that may contain sensitive information
# (DB credentials, hash salt, etc).
/web/sites/*/settings*.php
/web/sites/*/services*.yml

# Ignore paths that contain user-generated / auto-generated content -
# uploaded files AND their auto-generated derivatives (image styles,
# .avif/.webp conversions, etc, which can have very long filenames).
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/translations/

# Local environment / IDE files.
.env
.ddev/
.vscode/
.idea/

# PHPUnit cache.
.phpunit.result.cache

# OS junk files.
.DS_Store
Thumbs.db
